{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Debug RL Training",
            "module": "accelerate.commands.launch",
            "args": [
                "--num_processes",
                "1",
                "--main_process_port",
                "29763",
                "--config_file",
                "methods/RL/deep_speed.yaml",
                "methods/RL/main.py",
                "mode=train",
                "task=countdown2345",
                "task.train_size=1000",
                "model=qwen15",
                "algorithm=grpo",
                "algorithm.training.curriculum_schedule=vrex",
                "algorithm.training.scheduler_params.vrex_adds.gaussian=0.0",
                "algorithm.training.scheduler_params.vrex_adds.groupdro=0.0",
                "algorithm.training.scheduler_params.vrex_adds.sec=1.0",
                "algorithm.training.scheduler_params.min_prob=0.0",
                "algorithm.training.max_steps=1600",
                // "algorithm.training.vllm_mode=server",
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "5,0",
                "WANDB_PROJECT": "Sys2Bench",
                "ROOT_PATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        }
    ]
}